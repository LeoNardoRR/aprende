# Browser-safe Supabase configuration. Never place service_role or secret keys here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-publishable-key
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-publishable-key

# Server/CI only. Configure in the environment secret store, never in client builds.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-only-in-local-or-ci-secret-store
DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Operational identity; do not include PII.
APP_ENV=local
APP_RELEASE=development
LOG_LEVEL=info
